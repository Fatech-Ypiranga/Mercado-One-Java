<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mercadoone</groupId>
    <artifactId>pdv-desktop</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Mercado One PDV Desktop</name>
    <description>Cliente desktop JavaFX do PDV Mercado One</description>

    <properties>
        <java.version>25</java.version>
        <javafx.version>25.0.1</javafx.version>
        <junit.version>5.14.0</junit.version>
        <jackson.version>2.21.5</jackson.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.mercadoone.pdv.PdvDesktopApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Empacotamento do PDV com jpackage (JDK 25).
            mvn -Pinstaller package                      -> imagem de aplicacao em target/dist (sem instalador)
            mvn -Pinstaller package -Djpackage.type=msi  -> instalador Windows (exige WiX Toolset)
            mvn -Pinstaller package -Djpackage.type=deb  -> pacote Debian/Ubuntu
        -->
        <profile>
            <id>installer</id>
            <properties>
                <jpackage.type>app-image</jpackage.type>
                <jpackage.input>${project.build.directory}/jpackage-input</jpackage.input>
                <jpackage.appVersion>0.1.0</jpackage.appVersion>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-runtime-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${jpackage.input}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                              todir="${jpackage.input}"/>
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                        <exec executable="${java.home}/bin/jpackage" failonerror="true">
                                            <arg value="--type"/>
                                            <arg value="${jpackage.type}"/>
                                            <arg value="--name"/>
                                            <arg value="MercadoOnePDV"/>
                                            <arg value="--app-version"/>
                                            <arg value="${jpackage.appVersion}"/>
                                            <arg value="--vendor"/>
                                            <arg value="Mercado One"/>
                                            <arg value="--input"/>
                                            <arg value="${jpackage.input}"/>
                                            <arg value="--main-jar"/>
                                            <arg value="${project.build.finalName}.jar"/>
                                            <arg value="--main-class"/>
                                            <arg value="com.mercadoone.pdv.Launcher"/>
                                            <arg value="--dest"/>
                                            <arg value="${project.build.directory}/dist"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
